# ==========================================
# Forma Commercial AI Creative Studio - Environment Configuration
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development

# Database Settings
# Set your MongoDB connection URI (e.g. MongoDB Atlas or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/forma?retryWrites=true&w=majority
# If omitted or offline, Forma automatically falls back to its zero-config resilient local engine.
MONGODB_URI=mongodb://localhost:27017/forma

# Security & Authentication
JWT_SECRET=replace-with-a-secure-random-64-character-secret-key-in-production
JWT_EXPIRES_IN=7d

# File Storage Provider ('local' | 'cloudinary' | 's3')
STORAGE_PROVIDER=local

# Cloudinary Integration (Optional: activates when credentials provided)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 Integration (Optional: activates when credentials provided)
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# External AI Provider API Keys (Optional: when unset, Forma operates in high-quality Demo Synthesis mode)
OPENAI_API_KEY=
STABILITY_API_KEY=
RUNWAY_API_KEY=
LUMA_API_KEY=
FAL_KEY=

