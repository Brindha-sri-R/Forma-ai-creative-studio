# ==========================================
# Forma Commercial AI Creative Studio - Environment Configuration
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development

# Database Settings
# Set your MongoDB connection URI (e.g. MongoDB Atlas or local MongoDB)
# If omitted or unreachable, Forma operates automatically with zero-config local storage.
MONGODB_URI=mongodb://localhost:27017/forma

# Security & Authentication
JWT_SECRET=forma-enterprise-secret-key-2026-production
JWT_EXPIRES_IN=7d

# File Storage Provider ('gridfs' | 'local' | 'cloudinary' | 's3')
STORAGE_PROVIDER=gridfs

# Google Gemini API Key (Zero-cost text prompt enhancement)
GEMINI_API_KEY=

# Frontend API URL (leave blank if deploying unified full-stack)
VITE_API_URL=

# Cloudinary Integration (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 Integration (Optional)
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# External AI Provider API Keys (Optional: when unset, Forma operates in high-quality Demo Synthesis mode)
OPENAI_API_KEY=
STABILITY_API_KEY=
RUNWAY_API_KEY=
LUMA_API_KEY=
FAL_KEY=

